<Window x:Class="cifrarioXOR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cifrario XOR - RSA"
        Height="350" Width="650"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titolo e pulsante per cambiare algoritmo -->
        <Grid Grid.Row="0" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="CRITTOGRAFIA"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button x:Name="btnCambia"
                    Grid.Column="1"
                    Content="Passa a RSA"
                    Click="btnCambia_Click"
                    Width="120"
                    Height="35"/>

        </Grid>

        <!-- Inserimento del messaggio -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">

            <TextBlock Text="Inserisci il messaggio:"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="txtMessaggio"
                     Height="35"
                     FontSize="14"
                     Padding="5"/>

        </StackPanel>

        <!-- Crittografia -->
        <Grid Grid.Row="2" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Crittografa"
                    Click="btnCrittografa_Click"
                    Height="40"
                    Margin="0,0,10,0"/>

            <TextBox x:Name="txtCifrato"
                     Grid.Column="1"
                     Height="40"
                     FontSize="13"
                     Padding="5"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"/>

        </Grid>

        <!-- Decrittografia -->
        <Grid Grid.Row="3"
              VerticalAlignment="Top">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Decrittografa"
                    Click="btnDecrittografa_Click"
                    Height="40"
                    Margin="0,0,10,0"/>

            <TextBox x:Name="txtDecifrato"
                     Grid.Column="1"
                     Height="40"
                     FontSize="13"
                     Padding="5"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"/>

        </Grid>

    </Grid>

</Window>
